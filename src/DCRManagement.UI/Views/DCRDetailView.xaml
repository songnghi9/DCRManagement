<UserControl
    x:Class="DCRManagement.UI.Views.DCRDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DCRManagement.UI.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Border ClipToBounds="True" Style="{StaticResource CardBorderStyle}">
        <Grid Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ApprovalLogRow" Height="44" />
            </Grid.RowDefinitions>

            <!--
                ═══════════════════════════════════════════════════════════════
                ROW 0 — TOPBAR (68px)
                ════════════════════════════════════════════════════════════════
            -->
            <Border
                Grid.Row="0"
                Height="68"
                Background="{StaticResource SurfaceMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0" LastChildFill="False">

                    <!--  Left: DCR number + badge + hint  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="DcrNumberText"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryDarkBrush}" />
                        <Border
                            x:Name="StatusBadge"
                            Margin="10,0,0,0"
                            Padding="10,3"
                            VerticalAlignment="Center"
                            Background="{StaticResource MutedTextBrush}"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <TextBlock
                                x:Name="StatusBadgeText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                LineHeight="16" />
                        </Border>
                        <TextBlock
                            x:Name="HintText"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <!--  Right: workflow + action buttons  -->
                    <StackPanel
                        x:Name="TopbarActionsPanel"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <!--  Dynamic workflow buttons injected by code-behind  -->
                        <StackPanel x:Name="WorkflowActionsPanel" Orientation="Horizontal" />

                        <ui:Button
                            x:Name="SaveButton"
                            Margin="8,0,0,0"
                            Click="SaveButton_Click"
                            Content="Save Draft"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Icon="{ui:SymbolIcon Save24}" />
                        <ui:Button
                            x:Name="EditButton"
                            Margin="8,0,0,0"
                            Click="EditButton_Click"
                            Content="Edit"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Icon="{ui:SymbolIcon Edit24}" />
                        <ui:Button
                            x:Name="SubmitButton"
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Click="SubmitButton_Click"
                            Content="Submit to DCR"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Icon="{ui:SymbolIcon Send24}" />
                        <ui:Button
                            x:Name="CloseButton"
                            Margin="8,0,0,0"
                            Click="CloseButton_Click"
                            Content="Close"
                            CornerRadius="{StaticResource ButtonCornerRadius}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════════════
                ROW 1 — MAIN GRID (work area + side panel)
                ════════════════════════════════════════════════════════════════
            -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!--  ─── WORK AREA (col 0) ───────────────────────────────────  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Form strip (72px, 6 equal columns)  -->
                    <Border
                        Grid.Row="0"
                        Padding="14,10"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Change log no.  -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Change log no." />
                                <Border Style="{StaticResource ReadOnlyFieldStyle}">
                                    <TextBlock
                                        x:Name="ChangeLogText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource TextBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <!--  Category  -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Category" />
                                <ComboBox x:Name="CategoryComboBox">
                                    <ComboBoxItem Content="Safety" />
                                    <ComboBoxItem Content="Quality" />
                                    <ComboBoxItem Content="Service" />
                                    <ComboBoxItem Content="Productivity" />
                                </ComboBox>
                            </StackPanel>

                            <!--  Drawing no.  -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Drawing no." />
                                <ui:TextBox x:Name="DrawingNoTextBox" PlaceholderText="e.g. 12100520" />
                            </StackPanel>

                            <!--  Machine Model  -->
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Machine Model" />
                                <ui:TextBox x:Name="MachineTextBox" PlaceholderText="e.g. JSV6-EMU" />
                            </StackPanel>

                            <!--  Raised by  -->
                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Raised by" />
                                <Border Style="{StaticResource ReadOnlyFieldStyle}">
                                    <TextBlock
                                        x:Name="RaisedByText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource TextBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <!--  Raised date  -->
                            <!--
                            <StackPanel Grid.Column="5">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Raised date" />
                                <Border Style="{StaticResource ReadOnlyFieldStyle}">
                                    <TextBlock
                                        x:Name="RaisedDateText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </StackPanel>
                            -->
                            <StackPanel Grid.Column="5">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Raised date" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!--  TEXTBOX  -->
                                    <TextBox
                                        x:Name="RaisedDateText"
                                        Padding="8,4"
                                        VerticalContentAlignment="Center"
                                        Text="{Binding RaisedDate, StringFormat=dd/MM/yyyy, Mode=TwoWay}" />

                                    <!--  CALENDAR PICKER  -->
                                    <ui:CalendarDatePicker
                                        x:Name="RaisedDatePicker"
                                        Grid.Column="1"
                                        Width="40"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Date="{Binding RaisedDate, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>


                        </Grid>
                    </Border>

                    <!--  Reason row (150px, 2 cols)  -->
                    <Border
                        Grid.Row="1"
                        Padding="14,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Reason for change" />
                                <TextBox
                                    x:Name="ReasonTextBox"
                                    Height="100"
                                    Padding="10,8"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Action" />
                                <TextBox
                                    x:Name="ActionTextBox"
                                    Height="100"
                                    Padding="10,8"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Image stage (* height, 2 cols)  -->
                    <Grid Grid.Row="2" Background="{StaticResource BorderBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Before panel  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,1,0"
                            Style="{StaticResource ImageCanvasStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                    <DockPanel Margin="12,0" LastChildFill="False">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            FontWeight="SemiBold"
                                            Text="Before" />
                                    </DockPanel>
                                </Border>
                                <local:DCRImagePanelView x:Name="BeforeImagePanel" Grid.Row="1" />
                            </Grid>
                        </Border>

                        <!--  After panel  -->
                        <Border
                            Grid.Column="1"
                            Margin="0"
                            Style="{StaticResource ImageCanvasStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="0"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                    <DockPanel Margin="12,0" LastChildFill="False">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            FontWeight="SemiBold"
                                            Text="After" />
                                    </DockPanel>
                                </Border>
                                <local:DCRImagePanelView x:Name="AfterImagePanel" Grid.Row="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!--  ─── SIDE PANEL (col 1) ──────────────────────────────────  -->
                <Border
                    Grid.Column="1"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Scrollable content  -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">

                                <!--  ── Risk Assessment ──  -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Risk Assessment" />

                                    <!--  1. Leadtime  -->
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Style="{StaticResource FieldLabelStyle}"
                                                Text="1. Leadtime impact" />
                                            <ComboBox
                                                x:Name="LeadTimeComboBox"
                                                Width="128"
                                                DockPanel.Dock="Right">
                                                <ComboBoxItem Content="" />
                                                <ComboBoxItem Content="Yes" />
                                                <ComboBoxItem Content="No" />
                                            </ComboBox>
                                        </DockPanel>
                                        <TextBox
                                            x:Name="LeadTimeMemoBox"
                                            Height="64"
                                            Padding="10,8"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>

                                    <!--  2. Safety  -->
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Style="{StaticResource FieldLabelStyle}"
                                                Text="2. Safety impact" />
                                            <ComboBox
                                                x:Name="SafetyComboBox"
                                                Width="128"
                                                DockPanel.Dock="Right">
                                                <ComboBoxItem Content="" />
                                                <ComboBoxItem Content="Yes" />
                                                <ComboBoxItem Content="No" />
                                            </ComboBox>
                                        </DockPanel>
                                        <TextBox
                                            x:Name="SafetyMemoBox"
                                            Height="64"
                                            Padding="10,8"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>

                                    <!--  3. Compliance  -->
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Style="{StaticResource FieldLabelStyle}"
                                                Text="3. Compliance break" />
                                            <ComboBox
                                                x:Name="ComplianceComboBox"
                                                Width="128"
                                                DockPanel.Dock="Right">
                                                <ComboBoxItem Content="" />
                                                <ComboBoxItem Content="Yes" />
                                                <ComboBoxItem Content="No" />
                                            </ComboBox>
                                        </DockPanel>
                                        <TextBox
                                            x:Name="ComplianceMemoBox"
                                            Height="64"
                                            Padding="10,8"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>

                                    <!--  Saving + Cost metrics  -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Saving  -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Saving" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox
                                                    x:Name="SavingTextBox"
                                                    Grid.Column="0"
                                                    Margin="0,0,4,0"
                                                    PlaceholderText="0" />
                                                <ComboBox
                                                    x:Name="SavingCurrencyComboBox"
                                                    Grid.Column="1"
                                                    MinWidth="92">
                                                    <ComboBoxItem Content="Mvnd" />
                                                    <ComboBoxItem Content="USD" />
                                                    <ComboBoxItem Content="VND" />
                                                    <ComboBoxItem Content="AUD" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <!--  Cost  -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Cost" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox
                                                    x:Name="CostTextBox"
                                                    Grid.Column="0"
                                                    Margin="0,0,4,0"
                                                    PlaceholderText="0" />
                                                <ComboBox
                                                    x:Name="CostCurrencyComboBox"
                                                    Grid.Column="1"
                                                    MinWidth="92">
                                                    <ComboBoxItem Content="Mvnd" />
                                                    <ComboBoxItem Content="USD" />
                                                    <ComboBoxItem Content="VND" />
                                                    <ComboBoxItem Content="AUD" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!--  Separator  -->
                                <Border
                                    Height="1"
                                    Margin="0,0,0,16"
                                    Background="{StaticResource BorderBrush}" />

                                <!--  ── DCR Decision ──  -->
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="DCR Decision" />

                                    <!--  Suggestion  -->
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Suggestion" />
                                    <TextBox
                                        x:Name="SuggestionTextBox"
                                        Height="72"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Top"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />

                                    <!--  Consultant  -->
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Consultant" />
                                    <ComboBox x:Name="ConsultantComboBox" Margin="0,0,0,10" />

                                    <!--  Decision + Date  -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: Decision ComboBox -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Decision" />
                                            <ComboBox x:Name="ConsultantDecisionComboBox">
                                                <ComboBoxItem Content="" />
                                                <ComboBoxItem Content="Approve" />
                                                <ComboBoxItem Content="Reject" />
                                                <ComboBoxItem Content="Pending" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Col 1: Date — CalendarDatePicker same height as ComboBox -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Date" />
                                            <!-- Grid overlay: CalendarDatePicker + placeholder TextBlock -->
                                            <Grid MinHeight="36">
                                                <!-- CalendarDatePicker fills the cell — icon pinned to right -->
                                                <ui:CalendarDatePicker
                                                    x:Name="DecisionDatePicker"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Right"
                                                    Padding="0,0,8,0"
                                                    MinHeight="36"
                                                    IsTodayHighlighted="True" />
                                                <!-- Placeholder text — left-aligned, does not block clicks -->
                                                <TextBlock
                                                    x:Name="DecisionDatePlaceholder"
                                                    Text="Select date…"
                                                    FontSize="13"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Margin="12,0,32,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    IsHitTestVisible="False"
                                                    Visibility="Visible" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!--  Comment  -->
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Comment" />
                                    <TextBox
                                        x:Name="DecisionCommentTextBox"
                                        Height="72"
                                        VerticalContentAlignment="Top"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!--  Bottom bar (fixed)  -->
                        <Border
                            Grid.Row="1"
                            Padding="14,10"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DCR Decision" />
                                <ComboBox x:Name="DcrDecisionComboBox" Margin="0,0,0,10">
                                    <ComboBoxItem Content="" />
                                    <ComboBoxItem Content="Yes — Raise DCR" />
                                    <ComboBoxItem Content="No — Reject" />
                                </ComboBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button
                                        x:Name="SaveSideButton"
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        Click="SaveSideButton_Click"
                                        Content="Save"
                                        CornerRadius="{StaticResource ButtonCornerRadius}"
                                        Icon="{ui:SymbolIcon Save24}" />
                                    <ui:Button
                                        x:Name="SubmitSideButton"
                                        Grid.Column="1"
                                        Appearance="Primary"
                                        Click="SubmitSideButton_Click"
                                        Content="Submit to DCR"
                                        CornerRadius="{StaticResource ButtonCornerRadius}"
                                        Icon="{ui:SymbolIcon Send24}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--
                ═══════════════════════════════════════════════════════════════
                ROW 2 — APPROVAL / COMMENTS (collapsible)
                ════════════════════════════════════════════════════════════════
            -->
            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Header row  -->
                    <DockPanel Grid.Row="0" Margin="14,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            FontWeight="SemiBold"
                            Text="Approval / Comments" />
                        <ui:Button
                            x:Name="ToggleApprovalButton"
                            Click="ToggleApprovalButton_Click"
                            Content="Expand"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            DockPanel.Dock="Right" />
                    </DockPanel>

                    <!--  ui:DataGrid — Fluent styling built-in  -->
                    <ui:DataGrid
                        x:Name="ApprovalGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        IsReadOnly="True">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding ActorName}"
                                Header="Actor" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding ActorRole}"
                                Header="Role" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding ActionDisplay}"
                                Header="Action" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding ActionDate, StringFormat=dd/MM/yyyy HH:mm}"
                                Header="Date" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Comment}"
                                Header="Comment" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
