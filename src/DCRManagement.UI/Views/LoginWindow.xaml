<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sign in — DCR Management"
    Width="1000"
    Height="720"
    MinWidth="820"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Title="DCR Management"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#0B1220"
            ButtonsBackground="#0B1220"
            ButtonsForeground="#EAF0F7"
            CanMaximize="True"
            Foreground="#EAF0F7"
            ShowClose="True"
            ShowMaximize="True"
            ShowMinimize="True" />

        <!--  Left — brand panel  -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}">
            <Grid Margin="56">
                <StackPanel VerticalAlignment="Center">
                    <Border
                        Width="56"
                        Height="56"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Left"
                        Background="#2563EB"
                        CornerRadius="{StaticResource DialogCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="D" />
                    </Border>
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        LineHeight="38"
                        Text="DCR Management" />
                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="15"
                        Foreground="#94A3B8"
                        LineHeight="24"
                        Text="Document change requests, image review,&#x0a;and approval workflow."
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,36,0,0" Orientation="Horizontal">
                        <Border
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#1A2E4A"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="13"
                                    Foreground="#34D399"
                                    Symbol="Checkmark16" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CBD5E1"
                                    Text="Before / After" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#1A2E4A"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="13"
                                    Foreground="#34D399"
                                    Symbol="Checkmark16" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CBD5E1"
                                    Text="Approval flow" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="#1A2E4A"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="13"
                                    Foreground="#34D399"
                                    Symbol="Checkmark16" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CBD5E1"
                                    Text="Risk assessment" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Right — login form  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="{StaticResource AppBackgroundBrush}">
            <Border
                Margin="40"
                Padding="40,32"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DialogCornerRadius}"
                Effect="{StaticResource SoftShadow}">
                <StackPanel>

                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Welcome back" />
                    <TextBlock
                        Margin="0,6,0,16"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Sign in to your DCR account" />

                    <!--  ── Saved accounts section ──  -->
                    <Border
                        x:Name="SavedAccountsSection"
                        Margin="0,0,0,18"
                        Padding="0"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource InputCornerRadius}"
                        Visibility="Collapsed">
                        <StackPanel>

                            <!--  Header row  -->
                            <DockPanel Margin="12,10,12,8" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Symbol="People24" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="Saved accounts" />
                                </StackPanel>
                                <ui:Button
                                    x:Name="ClearAllAccountsButton"
                                    MinHeight="26"
                                    Padding="8,3"
                                    Click="ClearAllAccountsButton_Click"
                                    CornerRadius="{StaticResource ButtonCornerRadius}"
                                    DockPanel.Dock="Right"
                                    ToolTip="Remove all saved accounts">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,0,4,0"
                                            FontSize="12"
                                            Symbol="Delete24" />
                                        <TextBlock FontSize="11" Text="Clear all" />
                                    </StackPanel>
                                </ui:Button>
                            </DockPanel>

                            <!--  Account list — max 3 rows visible, scrollable  -->
                            <ScrollViewer
                                MaxHeight="100"
                                Margin="0,0,0,4"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SavedAccountsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  Each saved account row  -->
                                            <Border
                                                x:Name="AccountRow"
                                                Margin="6,2"
                                                Padding="10,8"
                                                Background="White"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource InputCornerRadius}"
                                                Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{x:Null}" MouseAction="LeftClick" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Avatar circle  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="30"
                                                        Height="30"
                                                        Margin="0,0,10,0"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="15">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Text="{Binding Initial}" />
                                                    </Border>

                                                    <!--  Username  -->
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Username}"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <!--  Use button  -->
                                                    <ui:Button
                                                        Grid.Column="2"
                                                        MinHeight="28"
                                                        Margin="8,0,6,0"
                                                        Padding="10,4"
                                                        Appearance="Primary"
                                                        Click="UseAccountButton_Click"
                                                        Content="Use"
                                                        CornerRadius="{StaticResource ButtonCornerRadius}"
                                                        Tag="{Binding}" />

                                                    <!--  Remove button  -->
                                                    <ui:Button
                                                        Grid.Column="3"
                                                        MinHeight="28"
                                                        Padding="6,4"
                                                        Click="RemoveAccountButton_Click"
                                                        CornerRadius="{StaticResource ButtonCornerRadius}"
                                                        Tag="{Binding}"
                                                        ToolTip="Remove this account">
                                                        <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                        </StackPanel>
                    </Border>

                    <!--  Username  -->
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Username" />
                    <ui:TextBox
                        x:Name="UsernameTextBox"
                        Margin="0,0,0,14"
                        Icon="{ui:SymbolIcon Person24}"
                        PlaceholderText="Enter your username" />

                    <!--  Password  -->
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                    <ui:PasswordBox
                        x:Name="PasswordBox"
                        Margin="0,0,0,12"
                        PasswordChanged="PasswordBox_PasswordChanged"
                        PlaceholderText="Enter your password" />

                    <!--  Options row  -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="ShowPasswordCheckBox"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Checked="ShowPasswordCheckBox_Changed"
                            Content="Show password"
                            Unchecked="ShowPasswordCheckBox_Changed" />
                        <CheckBox
                            x:Name="RememberMeCheckBox"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="Remember me"
                            ToolTip="Save credentials securely on this device" />
                    </Grid>

                    <!--  Error  -->
                    <ui:InfoBar
                        x:Name="ErrorInfoBar"
                        Margin="0,0,0,14"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error" />

                    <!--  Sign in  -->
                    <ui:Button
                        x:Name="LoginButton"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        Click="LoginButton_Click"
                        Content="Sign in"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        FontSize="14"
                        FontWeight="SemiBold" />

                    <!--  Security note  -->
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        TextAlignment="Center">
                        <ui:SymbolIcon FontSize="11" Symbol="ShieldCheckmark20" />
                        <Run Text=" Encrypted with Windows DPAPI" />
                    </TextBlock>

                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
