<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sign in — DCR Management"
    Width="1000"
    Height="640"
    MinWidth="820"
    MinHeight="540"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Title="DCR Management"
            ShowMinimize="True"
            ShowMaximize="True"
            ShowClose="True"
            CanMaximize="True"
            ButtonsBackground="#0B1220"
            ButtonsForeground="#EAF0F7"
            Background="#0B1220"
            Foreground="#EAF0F7" />

        <!-- Left — brand panel -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}">
            <Grid Margin="56">
                <StackPanel VerticalAlignment="Center">
                    <!-- Logo mark -->
                    <Border Width="56" Height="56" CornerRadius="{StaticResource DialogCornerRadius}" Background="#2563EB"
                            Margin="0,0,0,28" HorizontalAlignment="Left">
                        <TextBlock Text="D" Foreground="White" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="DCR Management" Foreground="White"
                               FontSize="32" FontWeight="Bold" LineHeight="38" />
                    <TextBlock Margin="0,14,0,0" FontSize="15" Foreground="#94A3B8"
                               Text="Document change requests, image review,&#x0a;and approval workflow."
                               TextWrapping="Wrap" LineHeight="24" />

                    <!-- Feature pills -->
                    <StackPanel Orientation="Horizontal" Margin="0,36,0,0">
                        <Border Background="#1A2E4A" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark16" Foreground="#34D399" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Before / After" Foreground="#CBD5E1" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1A2E4A" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark16" Foreground="#34D399" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Approval flow" Foreground="#CBD5E1" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1A2E4A" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark16" Foreground="#34D399" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Risk assessment" Foreground="#CBD5E1" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right — login form -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <Border Margin="40" Padding="40,36"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource DialogCornerRadius}"
                    Effect="{StaticResource SoftShadow}"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Welcome back" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Sign in to your DCR account"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" Margin="0,6,0,32" />

                    <!-- Username -->
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Username" />
                    <ui:TextBox x:Name="UsernameTextBox"
                                PlaceholderText="Enter your username"
                                Margin="0,0,0,16"
                                Icon="{ui:SymbolIcon Person24}" />

                    <!-- Password -->
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                    <ui:PasswordBox x:Name="PasswordBox"
                                    PlaceholderText="Enter your password"
                                    Margin="0,0,0,8"
                                    PasswordChanged="PasswordBox_PasswordChanged" />

                    <CheckBox x:Name="ShowPasswordCheckBox"
                              Content="Show password"
                              Margin="0,0,0,24"
                              Checked="ShowPasswordCheckBox_Changed"
                              Unchecked="ShowPasswordCheckBox_Changed" />

                    <!-- Error message -->
                    <ui:InfoBar x:Name="ErrorInfoBar"
                                Severity="Error"
                                IsOpen="False"
                                IsClosable="False"
                                Margin="0,0,0,16" />

                    <!-- Sign in button -->
                    <ui:Button x:Name="LoginButton"
                               Content="Sign in"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               MinHeight="42"
                               Click="LoginButton_Click"
                               CornerRadius="{StaticResource ButtonCornerRadius}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
