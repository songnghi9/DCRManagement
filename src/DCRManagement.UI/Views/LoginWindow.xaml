<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sign in — DCR Management"
    Width="1000"
    Height="640"
    MinWidth="820"
    MinHeight="540"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Title="DCR Management"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#0B1220"
            ButtonsBackground="#0B1220"
            ButtonsForeground="#EAF0F7"
            CanMaximize="True"
            Foreground="#EAF0F7"
            ShowClose="True"
            ShowMaximize="True"
            ShowMinimize="True" />

        <!--  Left — brand panel  -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}">
            <Grid Margin="56">
                <StackPanel VerticalAlignment="Center">
                    <!--  Logo mark  -->
                    <Border
                        Width="56"
                        Height="56"
                        Margin="0,0,0,28"
                        HorizontalAlignment="Left"
                        Background="#2563EB"
                        CornerRadius="{StaticResource DialogCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="D" />
                    </Border>

                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        LineHeight="38"
                        Text="DCR Management" />
                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="15"
                        Foreground="#94A3B8"
                        LineHeight="24"
                        Text="Document change requests, image review,&#x0a;and approval workflow."
                        TextWrapping="Wrap" />

                    <!--  Feature pills  -->
                    <StackPanel Margin="0,36,0,0" Orientation="Horizontal">
                        <Border
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#1A2E4A"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="13"
                                    Foreground="#34D399"
                                    Symbol="Checkmark16" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CBD5E1"
                                    Text="Before / After" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#1A2E4A"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="13"
                                    Foreground="#34D399"
                                    Symbol="Checkmark16" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CBD5E1"
                                    Text="Approval flow" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="#1A2E4A"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="13"
                                    Foreground="#34D399"
                                    Symbol="Checkmark16" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CBD5E1"
                                    Text="Risk assessment" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Right — login form  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="{StaticResource AppBackgroundBrush}">
            <Border
                Margin="40"
                Padding="40,36"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource DialogCornerRadius}"
                Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Welcome back" />
                    <TextBlock
                        Margin="0,6,0,32"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Sign in to your DCR account" />

                    <!--  Username  -->
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Username" />
                    <ui:TextBox
                        x:Name="UsernameTextBox"
                        Margin="0,0,0,16"
                        Icon="{ui:SymbolIcon Person24}"
                        PlaceholderText="Enter your username" />

                    <!--  Password  -->
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                    <ui:PasswordBox
                        x:Name="PasswordBox"
                        Margin="0,0,0,8"
                        PasswordChanged="PasswordBox_PasswordChanged"
                        PlaceholderText="Enter your password" />

                    <CheckBox
                        x:Name="ShowPasswordCheckBox"
                        Margin="0,0,0,24"
                        Checked="ShowPasswordCheckBox_Changed"
                        Content="Show password"
                        Unchecked="ShowPasswordCheckBox_Changed" />

                    <!--  Error message  -->
                    <ui:InfoBar
                        x:Name="ErrorInfoBar"
                        Margin="0,0,0,16"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error" />

                    <!--  Sign in button with rounded corners  -->

                    <ui:Button
                        x:Name="LoginButton"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        Click="LoginButton_Click"
                        Content="Sign in"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <!--<Button x:Name="LoginButton"
                        Content="Sign in"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        FontSize="14"
                        FontWeight="SemiBold"
                        MinHeight="44"
                        Click="LoginButton_Click" />-->


                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
