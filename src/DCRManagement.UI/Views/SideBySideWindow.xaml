<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.SideBySideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Before / After — Side by Side"
    Width="1400" Height="900"
    MinWidth="800" MinHeight="500"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    Background="#111827">

    <Grid>
        <Grid.RowDefinitions>
            <!-- TitleBar -->
            <RowDefinition Height="36" />
            <!-- Toolbar -->
            <RowDefinition Height="44" />
            <!-- Main viewer -->
            <RowDefinition Height="*" />
            <!-- Thumbnail strip -->
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <!-- ══ TITLEBAR ══════════════════════════════════════════════════════ -->
        <ui:TitleBar Grid.Row="0"
                     Title="Before / After — Side by Side"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     CanMaximize="True"
                     Background="#0D1117"
                     ButtonsBackground="#0D1117"
                     ButtonsForeground="#8FA3BF"
                     Foreground="#EAF0F7"
                     MinHeight="36" />

        <!-- ══ TOOLBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#161D2B"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" LastChildFill="False" VerticalAlignment="Center">

                <!-- Left: split presets -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Split:" Foreground="#8FA3BF" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="Split5050" Content="50 / 50"
                            Click="Split5050_Click"
                            Padding="10,4" MinHeight="28"
                            Background="#1F2937" Foreground="#EAF0F7"
                            BorderBrush="#374151" BorderThickness="1"
                            Margin="0,0,4,0" />
                    <Button x:Name="Split6040" Content="60 / 40"
                            Click="Split6040_Click"
                            Padding="10,4" MinHeight="28"
                            Background="#1F2937" Foreground="#EAF0F7"
                            BorderBrush="#374151" BorderThickness="1"
                            Margin="0,0,4,0" />
                    <Button x:Name="Split4060" Content="40 / 60"
                            Click="Split4060_Click"
                            Padding="10,4" MinHeight="28"
                            Background="#1F2937" Foreground="#EAF0F7"
                            BorderBrush="#374151" BorderThickness="1"
                            Margin="0,0,12,0" />

                    <!-- Sync scroll toggle -->
                    <CheckBox x:Name="SyncScrollCheck"
                              Content="Sync scroll"
                              IsChecked="True"
                              Foreground="#8FA3BF" FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                </StackPanel>

                <!-- Right: zoom controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Click="ZoomOut_Click" Padding="5,4" MinHeight="28"
                               CornerRadius="5" Margin="0,0,2,0" ToolTip="Zoom out (-)">
                        <ui:SymbolIcon Symbol="ZoomOut24" FontSize="12" />
                    </ui:Button>
                    <Slider x:Name="ZoomSlider"
                            Width="100" Minimum="10" Maximum="400" Value="100"
                            TickFrequency="25" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Margin="2,0"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <ui:Button Click="ZoomIn_Click" Padding="5,4" MinHeight="28"
                               CornerRadius="5" Margin="2,0,4,0" ToolTip="Zoom in (+)">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="12" />
                    </ui:Button>
                    <TextBlock x:Name="ZoomLabel" Text="100%"
                               FontSize="11" Foreground="#8FA3BF"
                               VerticalAlignment="Center" Width="40" Margin="0,0,6,0" />
                    <ui:Button Click="ZoomFit_Click" Content="Fit"
                               Padding="8,4" MinHeight="28" CornerRadius="5"
                               Margin="0,0,2,0" ToolTip="Fit to window" />
                    <ui:Button Click="ZoomActual_Click" Content="1:1"
                               Padding="8,4" MinHeight="28" CornerRadius="5"
                               ToolTip="Actual size" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ MAIN VIEWER ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" x:Name="ViewerGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BeforeCol" Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="AfterCol" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── BEFORE PANEL ── -->
            <Grid Grid.Column="0" Background="#0D1117">
                <!-- Label -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="12,8" Background="#80000000"
                        CornerRadius="6" Padding="12,4" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BeforeTitleText"
                                   Text="Before" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="BeforeIndexText"
                                   Foreground="#8FA3BF" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- ScrollViewer -->
                <ScrollViewer x:Name="BeforeScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="BeforeScroll_ScrollChanged">
                    <Image x:Name="BeforeImage"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16" />
                </ScrollViewer>

                <!-- Prev / Next for Before -->
                <ui:Button x:Name="BeforePrev"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="6,0"
                           Width="32" Height="52"
                           Padding="0"
                           CornerRadius="8"
                           Background="#50FFFFFF"
                           Foreground="White"
                           BorderThickness="0"
                           Opacity="0.85"
                           Click="BeforePrev_Click">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                </ui:Button>
                <ui:Button x:Name="BeforeNext"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="6,0"
                           Width="32" Height="52"
                           Padding="0"
                           CornerRadius="8"
                           Background="#50FFFFFF"
                           Foreground="White"
                           BorderThickness="0"
                           Opacity="0.85"
                           Click="BeforeNext_Click">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                </ui:Button>
            </Grid>

            <!-- ── SPLITTER ── -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#1F2937"
                          Cursor="SizeWE" />

            <!-- ── AFTER PANEL ── -->
            <Grid Grid.Column="2" Background="#0D1117">
                <!-- Label -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="12,8" Background="#80000000"
                        CornerRadius="6" Padding="12,4" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AfterTitleText"
                                   Text="After" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="AfterIndexText"
                                   Foreground="#8FA3BF" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- ScrollViewer -->
                <ScrollViewer x:Name="AfterScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="AfterScroll_ScrollChanged">
                    <Image x:Name="AfterImage"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16" />
                </ScrollViewer>

                <!-- Prev / Next for After -->
                <ui:Button x:Name="AfterPrev"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="6,0"
                           Width="32" Height="52"
                           Padding="0"
                           CornerRadius="8"
                           Background="#50FFFFFF"
                           Foreground="White"
                           BorderThickness="0"
                           Opacity="0.85"
                           Click="AfterPrev_Click">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                </ui:Button>
                <ui:Button x:Name="AfterNext"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="6,0"
                           Width="32" Height="52"
                           Padding="0"
                           CornerRadius="8"
                           Background="#50FFFFFF"
                           Foreground="White"
                           BorderThickness="0"
                           Opacity="0.85"
                           Click="AfterNext_Click">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                </ui:Button>
            </Grid>
        </Grid>

        <!-- ══ THUMBNAIL STRIP ════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#0D1117"
                BorderBrush="#1F2937"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Before thumbnails -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="8,0">
                    <ItemsControl x:Name="BeforeThumbStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="66" Height="66"
                                        Margin="4,8"
                                        CornerRadius="6"
                                        BorderThickness="2"
                                        BorderBrush="Transparent"
                                        Background="#1F2937"
                                        Cursor="Hand"
                                        ClipToBounds="True"
                                        Tag="{Binding Index}"
                                        MouseLeftButtonDown="BeforeThumb_Click">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Divider -->
                <Border Grid.Column="1" Background="#1F2937" />

                <!-- After thumbnails -->
                <ScrollViewer Grid.Column="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="8,0">
                    <ItemsControl x:Name="AfterThumbStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="66" Height="66"
                                        Margin="4,8"
                                        CornerRadius="6"
                                        BorderThickness="2"
                                        BorderBrush="Transparent"
                                        Background="#1F2937"
                                        Cursor="Hand"
                                        ClipToBounds="True"
                                        Tag="{Binding Index}"
                                        MouseLeftButtonDown="AfterThumb_Click">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
