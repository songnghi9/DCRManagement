<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.ImageLightboxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Image Viewer"
    Width="1200" Height="820"
    MinWidth="640" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    Background="#111827">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="Image Viewer"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     ShowClose="True"
                     CanMaximize="True"
                     Background="#0D1117"
                     ButtonsBackground="#0D1117"
                     ButtonsForeground="#8FA3BF"
                     Foreground="#EAF0F7"
                     MinHeight="36">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="ImageNameText"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#EAF0F7" VerticalAlignment="Center" />
                    <TextBlock x:Name="ImageIndexText"
                               FontSize="12" Foreground="#8FA3BF"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <!-- Side-by-side toggle -->
                    <ui:Button x:Name="SideBySideButton"
                               Content="Side by Side"
                               Appearance="Secondary"
                               Padding="10,3" MinHeight="24"
                               CornerRadius="5"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Click="SideBySideButton_Click"
                               ToolTip="Toggle Before/After side-by-side view"
                               Visibility="Collapsed" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main viewer area -->
        <Grid Grid.Row="1" x:Name="ViewerGrid" Background="#111827">

            <!-- Single image mode -->
            <Grid x:Name="SingleView">
                <Image x:Name="MainImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="16" />
                <ui:Button x:Name="PrevBtn"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="10,0"
                           Width="44" Height="44"
                           Padding="0"
                           CornerRadius="999"
                           Background="#DDFFFFFF"
                           Foreground="#666666"
                           BorderBrush="#BBBBBB"
                           BorderThickness="1.5"
                           Click="PrevBtn_Click">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="15" />
                </ui:Button>

                <ui:Button x:Name="NextBtn"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="10,0"
                           Width="44" Height="44"
                           Padding="0"
                           CornerRadius="999"
                           Background="#DDFFFFFF"
                           Foreground="#666666"
                           BorderBrush="#BBBBBB"
                           BorderThickness="1.5"
                           Click="NextBtn_Click">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="15" />
                </ui:Button>

            </Grid>

            <!-- Side-by-side mode -->
            <Grid x:Name="SideBySideView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Before panel -->
                <Grid Grid.Column="0" Background="#0D1117">
                    <Image x:Name="BeforeImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="12" />
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="12" Background="#80000000"
                            CornerRadius="6" Padding="10,4">
                        <TextBlock Text="Before" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Divider -->
                <Border Grid.Column="1" Background="#1F2937" />

                <!-- After panel -->
                <Grid Grid.Column="2" Background="#0D1117">
                    <Image x:Name="AfterImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="12" />
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="12" Background="#80000000"
                            CornerRadius="6" Padding="10,4">
                        <TextBlock Text="After" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Thumbnail strip -->
        <Border Grid.Row="2" Background="#0D1117"
                BorderBrush="#1F2937" BorderThickness="0,1,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="8,0">
                <ItemsControl x:Name="ThumbStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="70" Height="70"
                                    Margin="4,8"
                                    CornerRadius="6"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="#1F2937"
                                    Cursor="Hand"
                                    ClipToBounds="True"
                                    Tag="{Binding Index}"
                                    MouseLeftButtonDown="Thumb_Click">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
