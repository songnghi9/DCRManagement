<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.ImageLightboxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Image Viewer"
    Width="1100" Height="780"
    MinWidth="640" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    Background="#111827">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="LightboxTitleBar"
                     Title="Image Viewer"
                     ShowMinimize="False"
                     ShowMaximize="True"
                     ShowClose="True"
                     CanMaximize="True"
                     Background="#0D1117"
                     ButtonsBackground="#0D1117"
                     ButtonsForeground="#8FA3BF"
                     Foreground="#EAF0F7"
                     MinHeight="36">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="ImageNameText"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#EAF0F7"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ImageIndexText"
                               FontSize="12" Foreground="#8FA3BF"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main image area -->
        <Grid Grid.Row="1" Background="#111827">
            <Image x:Name="MainImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="16" />

            <!-- Prev / Next -->
            <Button x:Name="PrevBtn"
                    Content="‹" FontSize="32" FontWeight="Bold"
                    Width="44" Height="64"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="8,0" Opacity="0.75"
                    Background="#40FFFFFF" Foreground="White"
                    BorderThickness="0"
                    Click="PrevBtn_Click" />
            <Button x:Name="NextBtn"
                    Content="›" FontSize="32" FontWeight="Bold"
                    Width="44" Height="64"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="8,0" Opacity="0.75"
                    Background="#40FFFFFF" Foreground="White"
                    BorderThickness="0"
                    Click="NextBtn_Click" />
        </Grid>

        <!-- Thumbnail strip -->
        <Border Grid.Row="2" Background="#0D1117"
                BorderBrush="#1F2937" BorderThickness="0,1,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="8,0">
                <ItemsControl x:Name="ThumbStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="70" Height="70"
                                    Margin="4,8"
                                    CornerRadius="6"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="#1F2937"
                                    Cursor="Hand"
                                    ClipToBounds="True"
                                    Tag="{Binding Index}"
                                    MouseLeftButtonDown="Thumb_Click">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
