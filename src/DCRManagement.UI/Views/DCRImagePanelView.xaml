<UserControl
    x:Class="DCRManagement.UI.Views.DCRImagePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="True">

    <!--
    ┌─ Image grid (Fill) ─────────────────────────────────────────────┐
    │  [img][img][img]                                                 │
    │  [img][img]                                                      │
    │  (WrapPanel, tile size controlled by ZoomSlider)                │
    ├─ Toolbar (Bottom, 44px) ────────────────────────────────────────┤
    │  [Title][●N]  [🔍─────────────] [⛶][🗑][📋][+ Add]           │
    └─────────────────────────────────────────────────────────────────┘
    -->
    <DockPanel Background="#EEF3F9">

        <!-- ══ TOOLBAR — DockPanel.Dock=Bottom ══════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Height="44">
            <DockPanel Margin="10,0" LastChildFill="False" VerticalAlignment="Center">

                <!-- Left: gallery label + count badge -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="GalleryTitleText"
                               Text="Before"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Border x:Name="CountBadge"
                            Margin="7,0,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="10" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText"
                                   Text="0" FontSize="11" FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Right: zoom + actions -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Zoom icon -->
                    <ui:SymbolIcon Symbol="ZoomIn24" FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />

                    <!-- Zoom slider: 80–320px tile size -->
                    <Slider x:Name="ZoomSlider"
                            Width="90"
                            Minimum="80" Maximum="320" Value="140"
                            TickFrequency="20"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            ValueChanged="ZoomSlider_ValueChanged"
                            ToolTip="Tile size" />

                    <!-- Separator -->
                    <Border Width="1" Height="20"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,8,0" VerticalAlignment="Center" />

                    <!-- Fullscreen / side-by-side -->
                    <ui:Button x:Name="ExpandButton"
                               ToolTip="Fullscreen / side-by-side view"
                               Padding="7,5" MinHeight="30" CornerRadius="6"
                               Margin="0,0,4,0"
                               Click="ExpandButton_Click">
                        <ui:SymbolIcon Symbol="ArrowExpand20" FontSize="14" />
                    </ui:Button>

                    <!-- Delete selected -->
                    <ui:Button x:Name="DeleteButton"
                               ToolTip="Delete selected image"
                               Padding="7,5" MinHeight="30" CornerRadius="6"
                               Margin="0,0,4,0"
                               IsEnabled="False"
                               Click="DeleteButton_Click">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                    </ui:Button>

                    <!-- Paste from clipboard -->
                    <ui:Button x:Name="PasteButton"
                               ToolTip="Paste from clipboard (Ctrl+V)"
                               Padding="7,5" MinHeight="30" CornerRadius="6"
                               Margin="0,0,6,0"
                               Click="PasteButton_Click">
                        <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="14" />
                    </ui:Button>

                    <!-- Add from file -->
                    <ui:Button x:Name="AddButton"
                               Content="Add"
                               Appearance="Primary"
                               Padding="12,5" MinHeight="30" CornerRadius="6"
                               Click="AddButton_Click"
                               Icon="{ui:SymbolIcon Add24}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ IMAGE GRID — Fill ══════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="8,8,8,4">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinHeight="160"
                            Visibility="Visible">
                    <ui:SymbolIcon Symbol="Image24" FontSize="44"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="No images"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,4" />
                    <TextBlock Text="Click Add or paste (Ctrl+V)"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Tile grid — WrapPanel so tiles reflow on resize -->
                <ItemsControl x:Name="ImageGrid"
                              Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding TileSize}"
                                    Height="{Binding TileSize}"
                                    Margin="4"
                                    CornerRadius="8"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="#D6E4F0"
                                    Cursor="Hand"
                                    ClipToBounds="True"
                                    Tag="{Binding Index}"
                                    MouseLeftButtonDown="Tile_Click">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <!-- Selected ring -->
                                    <Border BorderThickness="3"
                                            CornerRadius="8"
                                            BorderBrush="{StaticResource PrimaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Index badge bottom-left -->
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="5"
                                            Background="#80000000"
                                            CornerRadius="4"
                                            Padding="5,2">
                                        <TextBlock Text="{Binding DisplayIndex}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>

                                    <!-- Delete button top-right -->
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="5"
                                            Width="22" Height="22"
                                            Background="#CCDC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="11" FontWeight="Bold"
                                            Content="✕"
                                            Tag="{Binding Index}"
                                            Click="TileDelete_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
