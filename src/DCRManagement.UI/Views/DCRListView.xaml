<UserControl
    x:Class="DCRManagement.UI.Views.DCRListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DCRManagement.UI.Common"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Filter / action toolbar  -->
        <Border
            Margin="0,0,0,14"
            Padding="16,12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PanelCornerRadius}"
            Effect="{StaticResource ShadowXs}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Search  -->
                <ui:TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search DCR number, title…"
                    TextChanged="Filter_Changed" />

                <!--  Status filter  -->
                <ComboBox
                    x:Name="StatusComboBox"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Status" />
                    <ComboBoxItem Content="Draft" />
                    <ComboBoxItem Content="Pending Review" />
                    <ComboBoxItem Content="Under Review" />
                    <ComboBoxItem Content="Pending Approval" />
                    <ComboBoxItem Content="Approved" />
                    <ComboBoxItem Content="Rejected" />
                    <ComboBoxItem Content="Closed" />
                </ComboBox>

                <!--  Priority filter  -->
                <ComboBox
                    x:Name="PriorityComboBox"
                    Grid.Column="2"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Priority" />
                    <ComboBoxItem Content="Low" />
                    <ComboBoxItem Content="Medium" />
                    <ComboBoxItem Content="High" />
                    <ComboBoxItem Content="Critical" />
                </ComboBox>

                <!--  Action buttons  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        MinWidth="90"
                        Click="RefreshButton_Click"
                        Content="Refresh"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        MinWidth="80"
                        Click="ViewButton_Click"
                        Content="View"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Icon="{ui:SymbolIcon Eye24}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        MinWidth="80"
                        Click="EditButton_Click"
                        Content="Edit"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Icon="{ui:SymbolIcon Edit24}" />
                    <ui:Button
                        Appearance="Primary"
                        MinWidth="110"
                        Click="CreateButton_Click"
                        Content="New DCR"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Icon="{ui:SymbolIcon Add24}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  DCR grid  -->
        <Border
            Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PanelCornerRadius}"
            Effect="{StaticResource ShadowXs}">
            <DataGrid
                x:Name="DcrGrid"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserAddRows="False"
                IsReadOnly="True"
                MouseDoubleClick="DcrGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding DCRNumber}"
                        Header="DCR no." />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Title}"
                        Header="Title" />
                    <DataGridTemplateColumn Width="160" Header="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding StatusDisplay, Converter={x:Static local:StatusColorConverter.Instance}}"
                                    CornerRadius="{StaticResource BadgeCornerRadius}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding StatusDisplay}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Priority}"
                        Header="Priority" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding CreatedBy}"
                        Header="Created by" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                        Header="Created at" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
