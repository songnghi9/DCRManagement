<UserControl
    x:Class="DCRManagement.UI.Views.UserManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Border
            Margin="0,0,0,14"
            Padding="16,12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PanelCornerRadius}"
            Effect="{StaticResource ShadowXs}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search name, username, email…"
                    TextChanged="Filter_Changed" />

                <ComboBox
                    x:Name="RoleComboBox"
                    Grid.Column="1"
                    SelectedIndex="0"
                    SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Roles" />
                    <ComboBoxItem Content="Admin" />
                    <ComboBoxItem Content="Engineer" />
                    <ComboBoxItem Content="Reviewer" />
                    <ComboBoxItem Content="Approver" />
                    <ComboBoxItem Content="ReadOnly" />
                </ComboBox>

                <ui:Button
                    Grid.Column="3"
                    Appearance="Primary"
                    Click="RefreshButton_Click"
                    Content="Refresh"
                    CornerRadius="{StaticResource ButtonCornerRadius}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
            </Grid>
        </Border>

        <!--  User grid  -->
        <Border
            Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PanelCornerRadius}"
            Effect="{StaticResource ShadowXs}">
            <ui:DataGrid
                x:Name="UserGrid"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserAddRows="False"
                IsReadOnly="True">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding FullName}"
                        Header="Full name" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Username}"
                        Header="Username" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Role}"
                        Header="Role" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Department}"
                        Header="Department" />
                    <DataGridCheckBoxColumn
                        Width="80"
                        Binding="{Binding IsActive}"
                        Header="Active" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</UserControl>
