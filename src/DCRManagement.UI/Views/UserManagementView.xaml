<UserControl
    x:Class="DCRManagement.UI.Views.UserManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Margin="0,0,0,14" Padding="16,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10"
                Effect="{StaticResource ShadowXs}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchTextBox"
                            Grid.Column="0"
                            PlaceholderText="Search name, username, email…"
                            Icon="{ui:SymbolIcon Search24}"
                            TextChanged="Filter_Changed"
                            Margin="0,0,10,0" />

                <ComboBox x:Name="RoleComboBox"
                          Grid.Column="1"
                          SelectionChanged="Filter_Changed"
                          SelectedIndex="0">
                    <ComboBoxItem Content="All Roles" />
                    <ComboBoxItem Content="Admin" />
                    <ComboBoxItem Content="Engineer" />
                    <ComboBoxItem Content="Reviewer" />
                    <ComboBoxItem Content="Approver" />
                    <ComboBoxItem Content="ReadOnly" />
                </ComboBox>

                <ui:Button Grid.Column="3" Content="Refresh"
                           Click="RefreshButton_Click"
                           Appearance="Primary" CornerRadius="8"
                           Icon="{ui:SymbolIcon ArrowSync24}" />
            </Grid>
        </Border>

        <!-- User grid -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10"
                ClipToBounds="True"
                Effect="{StaticResource ShadowXs}">
            <DataGrid x:Name="UserGrid"
                      AutoGenerateColumns="False"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Full name"   Binding="{Binding FullName}"   Width="*" />
                    <DataGridTextColumn Header="Username"    Binding="{Binding Username}"   Width="180" />
                    <DataGridTextColumn Header="Role"        Binding="{Binding Role}"       Width="130" />
                    <DataGridTextColumn Header="Department"  Binding="{Binding Department}" Width="180" />
                    <DataGridCheckBoxColumn Header="Active"  Binding="{Binding IsActive}"   Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
