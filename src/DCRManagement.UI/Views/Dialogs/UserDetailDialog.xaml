<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.Dialogs.UserDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="User Detail"
    Width="560"
    Height="460"
    MinWidth="460"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="User Detail"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"
                     CanMaximize="False"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}"
                     ButtonsBackground="{StaticResource SurfaceBrush}"
                     ButtonsForeground="{StaticResource MutedTextBrush}" />

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                Padding="24,12,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="User information"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,18" />

                <!-- Full name -->
                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="Full name" />
                <TextBox x:Name="FullNameTextBox"
                         Grid.Row="2"
                         Margin="0,0,0,12" />

                <!-- Email -->
                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="Email" />
                <TextBox x:Name="EmailTextBox"
                         Grid.Row="4"
                         Margin="0,0,0,12" />

                <!-- Role + Department -->
                <Grid Grid.Row="5" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Role" />
                        <ComboBox x:Name="RoleComboBox" SelectedIndex="1">
                            <ComboBoxItem Content="Admin" />
                            <ComboBoxItem Content="Engineer" />
                            <ComboBoxItem Content="Reviewer" />
                            <ComboBoxItem Content="Approver" />
                            <ComboBoxItem Content="ReadOnly" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Department" />
                        <TextBox x:Name="DepartmentTextBox" />
                    </StackPanel>
                </Grid>

                <!-- Active checkbox -->
                <CheckBox x:Name="IsActiveCheckBox"
                          Grid.Row="6"
                          Content="Active account"
                          IsChecked="True"
                          VerticalAlignment="Top" />

                <!-- Actions -->
                <StackPanel Grid.Row="7"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="Cancel"
                            Click="CancelButton_Click"
                            Margin="0,0,10,0"
                            MinWidth="90" />
                    <Button Content="Save"
                            Click="OkButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="90" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
