<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.Dialogs.UserDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="User Detail"
    Width="560"
    Height="460"
    MinWidth="460"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="User Detail"
            Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            ButtonsBackground="{StaticResource SurfaceBrush}"
            ButtonsForeground="{StaticResource MutedTextBrush}"
            CanMaximize="False"
            Foreground="{StaticResource TextBrush}"
            ShowClose="True"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Border
            Grid.Row="1"
            Padding="24,12,24,24"
            Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Title  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,18"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="User information" />

                <!--  Full name  -->
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="Full name" />
                <TextBox
                    x:Name="FullNameTextBox"
                    Grid.Row="2"
                    Margin="0,0,0,12" />

                <!--  Email  -->
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="Email" />
                <TextBox
                    x:Name="EmailTextBox"
                    Grid.Row="4"
                    Margin="0,0,0,12" />

                <!--  Role + Department  -->
                <Grid Grid.Row="5" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Role" />
                        <ComboBox x:Name="RoleComboBox" SelectedIndex="1">
                            <ComboBoxItem Content="Admin" />
                            <ComboBoxItem Content="Engineer" />
                            <ComboBoxItem Content="Reviewer" />
                            <ComboBoxItem Content="Approver" />
                            <ComboBoxItem Content="ReadOnly" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Department" />
                        <TextBox x:Name="DepartmentTextBox" />
                    </StackPanel>
                </Grid>

                <!--  Active checkbox  -->
                <CheckBox
                    x:Name="IsActiveCheckBox"
                    Grid.Row="6"
                    VerticalAlignment="Top"
                    Content="Active account"
                    IsChecked="True" />

                <!--  Actions  -->
                <StackPanel
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Content="Cancel" />
                    <Button
                        MinWidth="90"
                        Click="OkButton_Click"
                        Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
