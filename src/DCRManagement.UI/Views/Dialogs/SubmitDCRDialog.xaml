<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.Dialogs.SubmitDCRDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Submit DCR for Review"
    Width="520"
    Height="320"
    MinWidth="420"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar with Close only (no resize for dialogs)  -->
        <ui:TitleBar
            Title="Submit DCR for Review"
            Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            ButtonsBackground="{StaticResource SurfaceBrush}"
            ButtonsForeground="{StaticResource MutedTextBrush}"
            CanMaximize="False"
            Foreground="{StaticResource TextBrush}"
            ShowClose="True"
            ShowMaximize="False"
            ShowMinimize="False" />

        <!--  Content  -->
        <Border
            Grid.Row="1"
            Padding="24,16,24,24"
            Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Section title  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,18"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Assign reviewer and approver" />

                <!--  Reviewer  -->
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="Reviewer" />
                <ComboBox
                    x:Name="ReviewerComboBox"
                    Grid.Row="2"
                    Margin="0,0,0,14"
                    DisplayMemberPath="FullName"
                    SelectedValuePath="Id" />

                <!--  Approver  -->
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="Approver" />
                <ComboBox
                    x:Name="ApproverComboBox"
                    Grid.Row="4"
                    DisplayMemberPath="FullName"
                    SelectedValuePath="Id" />

                <!--  Actions  -->
                <StackPanel
                    Grid.Row="5"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Content="Cancel" />
                    <Button
                        MinWidth="130"
                        Click="SubmitButton_Click"
                        Content="Submit to Review"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
