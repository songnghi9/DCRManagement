<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.Dialogs.SubmitDCRDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Submit DCR for Review"
    Width="480"
    Height="320"
    MinWidth="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">

    <Border Margin="24" Background="{StaticResource SurfaceBrush}">
        <StackPanel>
            <TextBlock Text="Assign reviewer and approver"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,20" />

            <TextBlock Text="Reviewer" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox x:Name="ReviewerComboBox"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="Id"
                      Margin="0,0,0,16" />

            <TextBlock Text="Approver" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox x:Name="ApproverComboBox"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="Id"
                      Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Click="CancelButton_Click"
                           Margin="0,0,10,0" CornerRadius="8" />
                <ui:Button Content="Submit to Review" Click="SubmitButton_Click"
                           Appearance="Primary" CornerRadius="8"
                           Icon="{ui:SymbolIcon Send24}" />
            </StackPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>
