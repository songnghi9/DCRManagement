<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.Dialogs.ResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Reset Password"
    Width="460"
    Height="280"
    MinWidth="380"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Reset Password"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"
                     CanMaximize="False"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}"
                     ButtonsBackground="{StaticResource SurfaceBrush}"
                     ButtonsForeground="{StaticResource MutedTextBrush}" />

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                Padding="24,12,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Set new password"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,18" />

                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="New password" />
                <PasswordBox x:Name="PasswordBox"
                             Grid.Row="2"
                             MinHeight="34"
                             Padding="10,7"
                             Margin="0,0,0,12" />

                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="Confirm password" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Grid.Row="4"
                             MinHeight="34"
                             Padding="10,7" />

                <!-- Actions -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="Cancel"
                            Click="CancelButton_Click"
                            Margin="0,0,10,0"
                            MinWidth="90" />
                    <Button Content="Reset Password"
                            Click="OkButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
