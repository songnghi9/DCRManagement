<ui:FluentWindow
    x:Class="DCRManagement.UI.Views.Dialogs.CommentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Add Comment"
    Width="500"
    Height="300"
    MinWidth="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">

    <Border Margin="24" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Enter a comment" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <ui:TextBox x:Name="CommentTextBox"
                        Grid.Row="1"
                        PlaceholderText="Type your comment here…"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,16" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Click="CancelButton_Click"
                           Margin="0,0,10,0" CornerRadius="8" />
                <ui:Button Content="OK" Click="OkButton_Click"
                           Appearance="Primary" CornerRadius="8" />
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
