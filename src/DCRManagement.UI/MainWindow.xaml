<ui:FluentWindow x:Class="DCRManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DCR Management"
        Width="1600"
        Height="940"
        MinWidth="1280"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Override WPF-UI accent to match our brand blue -->
        <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#2563EB" />
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Title="DCR Management"
            ShowMinimize="True"
            ShowMaximize="True"
            ShowClose="True"
            CanMaximize="True"
            ButtonsBackground="#0B1220"
            ButtonsForeground="#EAF0F7"
            Background="#0B1220"
            Foreground="#EAF0F7"
            MinHeight="48">

            <!-- Page title + subtitle — vertically centered in the 48px TitleBar -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock x:Name="PageTitleText"
                               Text="DCR Requests"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#EAF0F7"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  —  "
                               FontSize="12"
                               Foreground="#8FA3BF"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PageSubtitleText"
                               Text="Search, review, create, and approve document change requests"
                               FontSize="12"
                               Foreground="#8FA3BF"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ui:TitleBar.Header>

            <!-- Date pill in the right area (before min/max/close buttons) -->
            <ui:TitleBar.TrailingContent>
                <Border Background="#1A2E4A"
                        BorderBrush="#2B3C54"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9,3"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:dd/MM/yyyy}}"
                               xmlns:sys="clr-namespace:System;assembly=mscorlib"
                               Foreground="#8FA3BF"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>
            </ui:TitleBar.TrailingContent>

        </ui:TitleBar>

        <!-- ── SIDEBAR ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition x:Name="SidebarContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon rail -->
                <Border Grid.Column="0" Background="#0E1726" BorderBrush="#26364C" BorderThickness="0,0,1,0">
                    <Grid Margin="10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Logo button -->
                        <ui:Button Width="42" Height="42"
                                   Click="ToggleSidebarButton_Click"
                                   Appearance="Primary"
                                   ToolTip="Collapse / expand sidebar"
                                   CornerRadius="{StaticResource IconButtonCornerRadius}">
                            <TextBlock Text="D" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ui:Button>

                        <!-- Nav icons -->
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <ui:Button ToolTip="DCR Requests" Click="DcrListButton_Click"
                                       Width="42" Height="42" Margin="0,0,0,8"
                                       Appearance="Primary" CornerRadius="{StaticResource IconButtonCornerRadius}">
                                <ui:SymbolIcon Symbol="List24" FontSize="18" />
                            </ui:Button>
                            <ui:Button ToolTip="Create DCR" Click="CreateDcrButton_Click"
                                       Width="42" Height="42" Margin="0,0,0,8"
                                       Background="Transparent" BorderBrush="#2B3C54" CornerRadius="{StaticResource IconButtonCornerRadius}">
                                <ui:SymbolIcon Symbol="Add24" FontSize="18" Foreground="#D9E3F0" />
                            </ui:Button>
                            <ui:Button ToolTip="Users" Click="UsersButton_Click"
                                       Width="42" Height="42"
                                       Background="Transparent" BorderBrush="#2B3C54" CornerRadius="{StaticResource IconButtonCornerRadius}">
                                <ui:SymbolIcon Symbol="People24" FontSize="18" Foreground="#D9E3F0" />
                            </ui:Button>
                        </StackPanel>

                        <!-- Sign out -->
                        <ui:Button Grid.Row="2" ToolTip="Sign out" Click="SignOutButton_Click"
                                   Width="42" Height="42"
                                   Background="Transparent" BorderBrush="#2B3C54" CornerRadius="{StaticResource IconButtonCornerRadius}">
                            <ui:SymbolIcon Symbol="ArrowExit20" FontSize="18" Foreground="#D9E3F0" />
                        </ui:Button>
                    </Grid>
                </Border>

                <!-- Expanded sidebar content -->
                <Grid x:Name="SidebarContentPanel" Grid.Column="1" Margin="16,18,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel>
                        <TextBlock Text="DCR" Foreground="White" FontSize="24" FontWeight="Bold" LineHeight="28" />
                        <TextBlock Text="Management" Foreground="#B9C5D4" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Workspace card -->
                    <StackPanel Grid.Row="1" Margin="0,24,0,16">
                        <TextBlock Text="WORKSPACE" Foreground="{StaticResource SidebarMutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
                        <Border Padding="12,10" CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource SidebarPanelBrush}">
                            <StackPanel>
                                <TextBlock Text="Engineering Change" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="DCR workflow" Foreground="#B9C5D4" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="NAVIGATION" Foreground="{StaticResource SidebarMutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />

                        <ui:Button x:Name="DcrListButton" Click="DcrListButton_Click"
                                   Style="{StaticResource SidebarNavButtonSelectedStyle}"
                                   CornerRadius="{StaticResource NavButtonCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="List24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="DCR Requests" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="CreateDcrButton" Click="CreateDcrButton_Click"
                                   Style="{StaticResource SidebarNavButtonStyle}"
                                   CornerRadius="{StaticResource NavButtonCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Create DCR" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="UsersButton" Click="UsersButton_Click"
                                   Style="{StaticResource SidebarNavButtonStyle}"
                                   CornerRadius="{StaticResource NavButtonCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Users" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- User card -->
                    <StackPanel Grid.Row="3">
                        <Border Padding="12,10" CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource SidebarPanelBrush}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#2563EB">
                                    <TextBlock Text="SA" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserNameText" Text="-" Foreground="White"
                                               FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="UserRoleText" Text="-" Foreground="#B9C5D4" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ui:Button Click="SignOutButton_Click"
                                   Style="{StaticResource SidebarNavButtonStyle}"
                                   CornerRadius="{StaticResource NavButtonCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExit20" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock Text="Sign out" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="16,12,16,16">
            <ContentControl x:Name="ContentHost" />
        </Grid>
    </Grid>
</ui:FluentWindow>
