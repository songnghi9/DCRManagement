<ui:FluentWindow
    x:Class="DCRManagement.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DCR Management"
    Width="1600"
    Height="940"
    MinWidth="1280"
    MinHeight="780"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!--  Override WPF-UI accent to match our brand blue  -->
        <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#2563EB" />
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Title="DCR Management"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#0B1220"
            ButtonsBackground="#0B1220"
            ButtonsForeground="#EAF0F7"
            CanMaximize="True"
            Foreground="#EAF0F7"
            ShowClose="True"
            ShowMaximize="True"
            ShowMinimize="True" />

        <!--  ── SIDEBAR ───────────────────────────────────────────────────  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition x:Name="SidebarContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Icon rail  -->
                <Border
                    Grid.Column="0"
                    Background="#0E1726"
                    BorderBrush="#26364C"
                    BorderThickness="0,0,1,0">
                    <Grid Margin="10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Logo button  -->
                        <ui:Button
                            Width="42"
                            Height="42"
                            Appearance="Primary"
                            Click="ToggleSidebarButton_Click"
                            CornerRadius="{StaticResource IconButtonCornerRadius}"
                            ToolTip="Collapse / expand sidebar">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="D" />
                        </ui:Button>

                        <!--  Nav icons  -->
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <ui:Button
                                Width="42"
                                Height="42"
                                Margin="0,0,0,8"
                                Appearance="Primary"
                                Click="DcrListButton_Click"
                                CornerRadius="{StaticResource IconButtonCornerRadius}"
                                ToolTip="DCR Requests">
                                <ui:SymbolIcon FontSize="18" Symbol="List24" />
                            </ui:Button>
                            <ui:Button
                                Width="42"
                                Height="42"
                                Margin="0,0,0,8"
                                Background="Transparent"
                                BorderBrush="#2B3C54"
                                Click="CreateDcrButton_Click"
                                CornerRadius="{StaticResource IconButtonCornerRadius}"
                                ToolTip="Create DCR">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Foreground="#D9E3F0"
                                    Symbol="Add24" />
                            </ui:Button>
                            <ui:Button
                                Width="42"
                                Height="42"
                                Background="Transparent"
                                BorderBrush="#2B3C54"
                                Click="UsersButton_Click"
                                CornerRadius="{StaticResource IconButtonCornerRadius}"
                                ToolTip="Users">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Foreground="#D9E3F0"
                                    Symbol="People24" />
                            </ui:Button>
                        </StackPanel>

                        <!--  Sign out  -->
                        <ui:Button
                            Grid.Row="2"
                            Width="42"
                            Height="42"
                            Background="Transparent"
                            BorderBrush="#2B3C54"
                            Click="SignOutButton_Click"
                            CornerRadius="{StaticResource IconButtonCornerRadius}"
                            ToolTip="Sign out">
                            <ui:SymbolIcon
                                FontSize="18"
                                Foreground="#D9E3F0"
                                Symbol="ArrowExit20" />
                        </ui:Button>
                    </Grid>
                </Border>

                <!--  Expanded sidebar content  -->
                <Grid
                    x:Name="SidebarContentPanel"
                    Grid.Column="1"
                    Margin="16,18,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Brand  -->
                    <StackPanel>
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            LineHeight="28"
                            Text="DCR" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="#B9C5D4"
                            Text="Management" />
                    </StackPanel>

                    <!--  Workspace card  -->
                    <StackPanel Grid.Row="1" Margin="0,24,0,16">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource SidebarMutedBrush}"
                            Text="WORKSPACE" />
                        <Border
                            Padding="12,10"
                            Background="{StaticResource SidebarPanelBrush}"
                            CornerRadius="{StaticResource PanelCornerRadius}">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Engineering Change" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="#B9C5D4"
                                    Text="DCR workflow" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Navigation  -->
                    <StackPanel Grid.Row="2">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource SidebarMutedBrush}"
                            Text="NAVIGATION" />

                        <ui:Button
                            x:Name="DcrListButton"
                            Click="DcrListButton_Click"
                            CornerRadius="{StaticResource NavButtonCornerRadius}"
                            Style="{StaticResource SidebarNavButtonSelectedStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    Symbol="List24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                    Text="DCR Requests" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="CreateDcrButton"
                            Click="CreateDcrButton_Click"
                            CornerRadius="{StaticResource NavButtonCornerRadius}"
                            Style="{StaticResource SidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    Symbol="Add24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                    Text="Create DCR" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button
                            x:Name="UsersButton"
                            Click="UsersButton_Click"
                            CornerRadius="{StaticResource NavButtonCornerRadius}"
                            Style="{StaticResource SidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    Symbol="People24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                    Text="Users" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!--  User card  -->
                    <StackPanel Grid.Row="3">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Background="{StaticResource SidebarPanelBrush}"
                            CornerRadius="{StaticResource PanelCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="#2563EB"
                                    CornerRadius="16">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="SA" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="UserNameText"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="-" />
                                    <TextBlock
                                        x:Name="UserRoleText"
                                        FontSize="11"
                                        Foreground="#B9C5D4"
                                        Text="-" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ui:Button
                            Click="SignOutButton_Click"
                            CornerRadius="{StaticResource NavButtonCornerRadius}"
                            Style="{StaticResource SidebarNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,10,0"
                                    FontSize="15"
                                    Symbol="ArrowExit20" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                    Text="Sign out" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  ── MAIN CONTENT ───────────────────────────────────────────────  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Page header card  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,16"
                Padding="22,18"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            x:Name="PageTitleText"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryDarkBrush}"
                            Text="DCR Requests" />
                        <TextBlock
                            x:Name="PageSubtitleText"
                            Margin="0,5,0,0"
                            FontSize="13"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="Search, review, create, and approve document change requests" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource PanelCornerRadius}">
                        <TextBlock
                            xmlns:sys="clr-namespace:System;assembly=mscorlib"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:dd/MM/yyyy}}" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
