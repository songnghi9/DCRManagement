<Window x:Class="DCRManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="DCR Management"
        Width="1600"
        Height="940"
        MinWidth="1280"
        MinHeight="780"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition x:Name="SidebarContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FF0E1726" BorderBrush="#FF26364C" BorderThickness="0,0,1,0">
                    <Grid Margin="10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Width="42" Height="42" Click="ToggleSidebarButton_Click" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" ToolTip="Collapse / expand side panel" ui:ControlHelper.CornerRadius="8">
                            <TextBlock Text="D" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <Button ToolTip="DCR Requests" Click="DcrListButton_Click" Width="42" Height="42" Margin="0,0,0,10" Background="#FF256DB4" BorderBrush="#FF256DB4" ui:ControlHelper.CornerRadius="8">
                                <TextBlock Text="≡" Foreground="White" FontSize="19" HorizontalAlignment="Center" />
                            </Button>
                            <Button ToolTip="Create DCR" Click="CreateDcrButton_Click" Width="42" Height="42" Margin="0,0,0,10" Background="Transparent" BorderBrush="#FF2B3C54" ui:ControlHelper.CornerRadius="8">
                                <TextBlock Text="+" Foreground="#FFD9E3F0" FontSize="22" HorizontalAlignment="Center" />
                            </Button>
                            <Button ToolTip="Users" Click="UsersButton_Click" Width="42" Height="42" Background="Transparent" BorderBrush="#FF2B3C54" ui:ControlHelper.CornerRadius="8">
                                <TextBlock Text="◎" Foreground="#FFD9E3F0" FontSize="18" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="2" ToolTip="Sign out" Click="SignOutButton_Click" Width="42" Height="42" Background="Transparent" BorderBrush="#FF2B3C54" ui:ControlHelper.CornerRadius="8">
                            <TextBlock Text="⎋" Foreground="#FFD9E3F0" FontSize="18" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Grid x:Name="SidebarContentPanel" Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="DCR" Foreground="White" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Management" Foreground="#FFB9C5D4" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,18">
                    <TextBlock Text="Workspace" Foreground="#FF8291A8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Padding="12" CornerRadius="8" Background="{StaticResource SidebarPanelBrush}">
                        <StackPanel>
                            <TextBlock Text="Engineering Change" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="DCR workflow" Foreground="#FFB9C5D4" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Navigation" Foreground="#FF8291A8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button x:Name="DcrListButton" Click="DcrListButton_Click" Style="{StaticResource SidebarNavButtonSelectedStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="≡" FontSize="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="DCR Requests" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="CreateDcrButton" Click="CreateDcrButton_Click" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="+" FontSize="19" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Create DCR" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="UsersButton" Click="UsersButton_Click" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="◎" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Users" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Padding="12" CornerRadius="8" Background="{StaticResource SidebarPanelBrush}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FF2D6FAB">
                                <TextBlock Text="SA" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UserNameText" Text="-" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock x:Name="UserRoleText" Text="-" Foreground="#FFB9C5D4" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="Sign out" Click="SignOutButton_Click" Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="DCR Requests" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" LineHeight="28" />
                        <TextBlock x:Name="PageSubtitleText" Text="Search, review, create, and approve document change requests" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:dd/MM/yyyy}}" xmlns:sys="clr-namespace:System;assembly=mscorlib" Foreground="{StaticResource MutedTextBrush}" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="0,14,0,0" />
        </Grid>
    </Grid>
</Window>
